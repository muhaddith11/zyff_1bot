# ── Telegram ────────────────────────────────────────────────
# @BotFather dan oling: /newbot -> tokenni shu yerga qo'ying
TELEGRAM_BOT_TOKEN=

# ── Rasm AI ─────────────────────────────────────────────────
# cloudflare (bepul) | gemini (billing shart) | replicate (kredit bilan)
IMAGE_PROVIDER=cloudflare

# Cloudflare Workers AI — kuniga 10 000 neuron bepul, keyin Workers Paid (klein-9b ≈ $0.02/rasm).
# dash.cloudflare.com → Workers AI → Use REST API → token + Account ID
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Default: klein-9b (detallar aniq). Arzon, lekin detallarni buzadigan rejim:
# CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Gemini kaliti — https://aistudio.google.com/apikey
# DIQQAT: rasm modellari bepul tarifda yo'q (429, limit: 0) — AI Studio'da
# kalit loyihasiga billing ulang (kamida $5 oldindan to'lov).
GEMINI_API_KEY=
# Ixtiyoriy (arzonrog'i: gemini-3.1-flash-lite-image):
GEMINI_MODEL=gemini-3.1-flash-image

# ── Ruxsat (ixtiyoriy, tavsiya) ─────────────────────────
# Admin'ning Telegram ID'si — botda /id yozsangiz ko'rsatadi. To'ldirilsa, botdan faqat
# admin ruxsat bergan odamlar foydalanadi: yangi odam yozganda adminga so'rov keladi.
# Bo'sh bo'lsa — bot hamma uchun ochiq. Ruxsatlar ro'yxati: admin chatida /users
ADMIN_ID=

# ── Webhook xavfsizligi (ixtiyoriy, lekin tavsiya) ─────────
# Istalgan tasodifiy matn. Vercel env'ga ham, set-webhook'ga ham shu ishlatiladi.
WEBHOOK_SECRET=

# ── Replicate (ixtiyoriy zaxira provayder) ─────────────────
# IMAGE_PROVIDER=replicate qilsangiz ishlatiladi
# REPLICATE_API_TOKEN=
# REPLICATE_MODEL=black-forest-labs/flux-kontext-pro
